%% Lib Core hierarchy
BEFW-LIB-CORE --> MES-LIB-CORE
MES-LIB-CORE --> MOS-LIB-CORE
MOS-LIB-CORE --> MOS-LIB-OFS-CORE
MOS-LIB-CORE --> MOS-LIB-RTD-CORE
MOS-LIB-CORE --> MOS-LIB-MRS-CORE
%% Lib Data hierarchy
BEFW-LIB-CORE --> MES-LIB-DATA
MES-LIB-DATA --> MOS-LIB-DATA
MOS-LIB-DATA --> MOS-LIB-OFS-DATA
MOS-LIB-DATA --> MOS-LIB-RTD-DATA
MOS-LIB-DATA --> MOS-LIB-MRS-DATA
%% Lib Spec hierarchy
BEFW-LIB-CORE --> MES-LIB-SPEC
MES-LIB-SPEC --> MOS-LIB-CMN-LOGIC
%% Application Lib hierarchy
%%% OFS Application hierarchy
MOS-LIB-OFS-CORE --> MOS-LIB-OFS-LOGIC
MES-LIB-SPEC --> MOS-LIB-OFS-LOGIC
MOS-LIB-OFS-DATA --> MOS-LIB-OFS-LOGIC
%%% MRS Application hierarchy
MOS-LIB-MRS-CORE --> MOS-LIB-MRS-LOGIC
MES-LIB-SPEC --> MOS-LIB-MRS-LOGIC
MOS-LIB-MRS-DATA --> MOS-LIB-MRS-LOGIC
%%% RTD Application hierarchy
MOS-LIB-RTD-CORE --> MOS-LIB-RTD-LOGIC
MES-LIB-SPEC --> MOS-LIB-RTD-LOGIC
MOS-LIB-RTD-DATA --> MOS-LIB-RTD-LOGIC
%% Application hierarchy
%%% OFS Application hierarchy
MOS-LIB-OFS-LOGIC --> OFS-SERVICE
MOS-LIB-CMN-LOGIC --> OFS-SERVICE
%%% MRS Application hierarchy
MOS-LIB-MRS-LOGIC --> MRS-SERVICE
MOS-LIB-CMN-LOGIC --> MRS-SERVICE
